# ── next-auth (05번~) ────────────────────────────────────────
# 세션 암호화에 사용하는 비밀 키
# openssl rand -base64 32 으로 생성하거나, 개발 중엔 아무 문자열이나 가능
AUTH_SECRET=your-secret-key-change-in-production

# ── 04번: JWT 직접 구현 ──────────────────────────────────────
# JWT 서명/검증에 사용하는 비밀 키 (AUTH_SECRET과 별개로 관리)
JWT_SECRET=your-jwt-secret-change-in-production

# ── 06번: Google 소셜 로그인 ─────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials 에서 생성
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 07번: Kakao 소셜 로그인 ──────────────────────────────────
# Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── 08번: Naver 소셜 로그인 ──────────────────────────────────
# Naver Developers → 애플리케이션 → Client ID / Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 18~19번: 이메일 발송 (Resend) ────────────────────────────
# resend.com 에서 API 키 발급
RESEND_API_KEY=

# ── 12번: Database strategy (Prisma) ────────────────────────
DATABASE_URL="file:./dev.db"
